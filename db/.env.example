# 本地開發用連線字串。實際的 .env 不進版控(見 db/README.md)。
# migration 帳號:可改 schema,只給 Alembic 用
DATABASE_URL_MIGRATE=postgresql+psycopg://pet_camera_migrate:migrate_local_pw@localhost:5432/pet_camera
# 應用程式帳號:只能讀寫資料,不能改 schema,給七個微服務用
DATABASE_URL_APP=postgresql+psycopg://pet_camera_app:app_local_pw@localhost:5432/pet_camera
# 唯讀帳號:給分析/報表/手動查詢用
DATABASE_URL_READONLY=postgresql+psycopg://pet_camera_readonly:readonly_local_pw@localhost:5432/pet_camera
