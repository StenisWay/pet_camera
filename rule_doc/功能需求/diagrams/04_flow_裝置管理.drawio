<mxfile host="app.diagrams.net">
  <diagram name="裝置管理">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="開始(進入裝置管理頁)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="0" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="GET /devices 取得裝置列表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="action" value="使用者操作?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="190" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="修改 name 欄位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="PATCH /devices/{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="即時顯示新名稱" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="顯示二次確認對話框" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="使用者確認?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="430" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="取消,維持原狀" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="DELETE /devices/{id}
刪除事件與 R2 影片/縮圖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="550" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="裝置狀態重置為 pending
user_id 清空" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="660" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="導回裝置列表,移除該卡片" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="770" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nf" value="DEVICE_005
裝置不存在或已被移除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="190" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="p1">
          <mxGeometry relative="1" as="geometry" />
