          <mxGeometry x="20" y="20" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="cursor-based 分頁載入事件列表
(依 started_at 由新到舊)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
