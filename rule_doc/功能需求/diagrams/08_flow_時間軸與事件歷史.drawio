<mxfile host="app.diagrams.net">
  <diagram name="時間軸與事件歷史">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="790" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
